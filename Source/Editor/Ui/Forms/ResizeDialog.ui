<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ResizeDialog</class>
 <!-- Redimensionnement du niveau : la mise en page quitte le C++ pour ce fichier, comme
      toute autre mise en page du projet. Le code ne fait plus que borner les valeurs, lire la
      taille courante et confirmer une perte de contenu (EX-EDIT-012, EX-EDIT-017).
      Les libelles poses ici sont des reperes pour Qt Designer : retranslateUi les remplace tous
      (EX-REN-033). -->
 <widget class="QDialog" name="ResizeDialog">
  <property name="windowTitle"><string>Redimensionner le niveau</string></property>
  <layout class="QFormLayout" name="form">
   <item row="0" column="0">
    <widget class="QLabel" name="widthLabel"><property name="text"><string>Largeur</string></property></widget>
   </item>
   <item row="0" column="1">
    <widget class="QSpinBox" name="widthSpin">
     <property name="minimum"><number>1</number></property>
     <property name="maximum"><number>100</number></property>
    </widget>
   </item>
   <item row="1" column="0">
    <widget class="QLabel" name="heightLabel"><property name="text"><string>Hauteur</string></property></widget>
   </item>
   <item row="1" column="1">
    <widget class="QSpinBox" name="heightSpin">
     <property name="minimum"><number>1</number></property>
     <property name="maximum"><number>100</number></property>
    </widget>
   </item>
   <item row="2" column="0" colspan="2">
    <widget class="QDialogButtonBox" name="buttons">
     <property name="orientation"><enum>Qt::Horizontal</enum></property>
     <property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set></property>
    </widget>
   </item>
  </layout>
 </widget>
