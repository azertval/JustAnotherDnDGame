<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>LayersPanel</class>
 <!-- Panneau « Couches » (LOT-11). La liste montre les couches du dessus vers le dessous, telles
      que l'editeur les dessine : la grille racine en tete (la collision se superpose a l'image),
      puis les couches visuelles de la plus en avant a la plus en arriere. Les libelles poses ici
      sont des reperes pour Qt Designer : retranslateUi les remplace tous (EX-REN-033). -->
 <widget class="QWidget" name="LayersPanel">
  <layout class="QVBoxLayout" name="layout">
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>
   <item>
    <widget class="QListWidget" name="layerList">
     <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
     <property name="editTriggers"><set>QAbstractItemView::DoubleClicked|QAbstractItemView::EditKeyPressed</set></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="opacityRow">
     <item>
      <widget class="QLabel" name="opacityLabel">
       <property name="text"><string>Opacité</string></property>
      </widget>
     </item>
     <item>
      <widget class="QSlider" name="opacitySlider">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="minimum"><number>0</number></property>
       <property name="maximum"><number>100</number></property>
       <property name="value"><number>100</number></property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="opacityValue">
       <property name="minimumWidth"><number>36</number></property>
       <property name="text"><string>100 %</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QGridLayout" name="buttons">
     <item row="0" column="0">
      <widget class="QPushButton" name="addGroundButton">
       <property name="text"><string>Ajouter un sol</string></property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QPushButton" name="addDecorButton">
       <property name="text"><string>Ajouter un décor</string></property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QPushButton" name="moveForwardButton">
       <property name="text"><string>Monter</string></property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QPushButton" name="moveBackwardButton">
       <property name="text"><string>Descendre</string></property>
      </widget>
     </item>
     <item row="2" column="0" colspan="2">
      <widget class="QPushButton" name="removeButton">
       <property name="text"><string>Retirer</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
