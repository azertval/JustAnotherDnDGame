/* Projet Qt Design Studio des ecrans du jeu (LOT-86).
 *
 * C'est le fichier que la conception ouvre. Il ne decrit QUE Source/Ui et les assets :
 * ni CMake, ni Source/HMI, ni une ligne de C++ n'y sont visibles. C'est la frontiere,
 * rendue litterale par le perimetre de ce fichier.
 *
 * Ouvrir avec : D:/Qt/Tools/QtDesignStudio/bin/qtdesignstudio.exe Source/Ui/JadgUi.qmlproject
 */
import QmlProject 1.1

Project {
    mainFile: "Main.qml"

    // AUCUNE version de Qt n'est ecrite ici : le runtime est epingle par CMake, tandis que Design
    // Studio utilise le Qt fourni par son kit. Les imports restent sans version pour eviter un
    // troisieme verrou de version.
    qt6Project: true

    QmlFiles   { directory: "." }
    ImageFiles { directory: "../Elements/Assets" }
    FontFiles  { directory: "../Elements/Assets/Fonts" }

    // Le module Jadg.Ui est present dans le depot, donc Design Studio n'a plus besoin d'une
    // configuration CMake prealable pour resoudre `import Jadg.Ui`.
    Files { filter: "qmldir"; directory: "Jadg/Ui" }

    // Les types du module se resolvent depuis la racine de Source/Ui.
    importPaths: [ "." ]
}
