/* Qt Design Studio project for the design-only surface of Jadg.Ui.
 *
 * Open this project directly in Qt Design Studio 6.8.x. It deliberately contains no application
 * Main.qml, no C++ source, and no import of Jadg.Runtime.
 */
import QmlProject 1.1

Project {
    mainFile: "DesignStudio/Main.ui.qml"
    qt6Project: true

    QmlFiles { directory: "DesignStudio" }
    QmlFiles { directory: "Controls" }
    QmlFiles { directory: "Screens" }
    QmlFiles { directory: "Theme" }

    ImageFiles { directory: "../Elements/Assets" }
    FontFiles { directory: "../Elements/Assets/Fonts" }

    Files { filter: "qmldir"; directory: "Jadg/Ui" }
    importPaths: [ "." ]
}
