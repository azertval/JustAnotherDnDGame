<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>EditorMainWindow</class>
 <!-- Chassis de l'editeur (EX-IHM-073/EX-IHM-074).

      La barre de menus est organisee PAR NATURE D'ACTION (fichier, edition, carte, affichage,
      aide). Les reglages nombreux et homogenes (panneaux, theme) sont regroupes en SOUS-MENUS.

      Les commandes elles-memes ne sont PAS declarees ici : elles viennent du catalogue d'actions
      (hmi::editorActionCatalog), source unique exigee par EX-IHM-055. Le .ui declare les menus,
      leurs separateurs et les actions qui n'ont pas de commande derriere elles. -->
 <widget class="QMainWindow" name="EditorMainWindow">
  <property name="dockNestingEnabled"><bool>true</bool></property>
  <!-- Widget central : coquille exigee par Qt pour une QMainWindow, remplacee en code par le
       canevas de l'editeur. -->
  <widget class="QWidget" name="centralHost"/>

  <widget class="QToolBar" name="EditorToolBar">
   <property name="movable"><bool>false</bool></property>
   <attribute name="toolBarArea"><enum>TopToolBarArea</enum></attribute>
   <attribute name="toolBarBreak"><bool>false</bool></attribute>
  </widget>

  <widget class="QMenuBar" name="menubar">
   <widget class="QMenu" name="fileMenu">
    <property name="title"><string>Fichier</string></property>
    <!-- Enregistrer, Renommer : inseres en code depuis le catalogue, avant actResize. -->
    <addaction name="actResize"/>
    <addaction name="separator"/>
    <addaction name="actQuit"/>
   </widget>
   <widget class="QMenu" name="editMenu">
    <property name="title"><string>Édition</string></property>
    <!-- Annuler, Refaire, Copier, Coller : inseres en code depuis le catalogue. -->
   </widget>
   <widget class="QMenu" name="levelMenu">
    <property name="title"><string>Carte</string></property>
    <!-- Essayer : insere en code depuis le catalogue. -->
   </widget>
   <widget class="QMenu" name="viewMenu">
    <property name="title"><string>Affichage</string></property>
    <!-- Recadrer, Grille : inseres en code, avant les sous-menus. -->
    <addaction name="separator"/>
    <addaction name="panelsMenu"/>
    <addaction name="themeMenu"/>
   </widget>
   <widget class="QMenu" name="helpMenu">
    <property name="title"><string>Aide</string></property>
    <!-- Aperçu des raccourcis : insere en code depuis le catalogue. -->
   </widget>

   <!-- Sous-menu Panneaux : les bascules de visibilite des docks sont ajoutees en code
        (toggleViewAction). -->
   <widget class="QMenu" name="panelsMenu">
    <property name="title"><string>Panneaux</string></property>
    <addaction name="separator"/>
    <addaction name="actFollowActiveTool"/>
    <addaction name="actResetLayout"/>
   </widget>
   <widget class="QMenu" name="themeMenu">
    <property name="title"><string>Thème</string></property>
    <addaction name="actThemeSystem"/>
    <addaction name="actThemeLight"/>
    <addaction name="actThemeDark"/>
   </widget>

   <addaction name="fileMenu"/>
   <addaction name="editMenu"/>
   <addaction name="levelMenu"/>
   <addaction name="viewMenu"/>
   <addaction name="helpMenu"/>
  </widget>

  <!-- Panneaux dockables : coquilles nommées (objectName stable pour la persistance QSettings) ;
       leur contenu (arbre de palette, navigateur, couches, entites) est branché en code. -->
  <widget class="QDockWidget" name="PalettePanel">
   <property name="windowTitle"><string>Palette</string></property>
   <attribute name="dockWidgetArea"><number>1</number></attribute>
   <widget class="QWidget" name="paletteContents"/>
  </widget>
  <widget class="QDockWidget" name="LevelsPanel">
   <property name="windowTitle"><string>Cartes</string></property>
   <attribute name="dockWidgetArea"><number>2</number></attribute>
   <widget class="QWidget" name="levelsContents"/>
  </widget>
  <!-- Couches et entites de la carte (LOT-11). -->
  <widget class="QDockWidget" name="LayersPanel">
   <property name="windowTitle"><string>Couches</string></property>
   <attribute name="dockWidgetArea"><number>1</number></attribute>
   <widget class="QWidget" name="layersContents"/>
  </widget>
  <widget class="QDockWidget" name="EntitiesPanel">
   <property name="windowTitle"><string>Entités</string></property>
   <attribute name="dockWidgetArea"><number>2</number></attribute>
   <widget class="QWidget" name="entitiesContents"/>
  </widget>

  <action name="actQuit"><property name="text"><string>Quitter</string></property></action>
  <action name="actResize"><property name="text"><string>Redimensionner…</string></property></action>
  <action name="actResetLayout"><property name="text"><string>Réinitialiser la disposition</string></property></action>
  <action name="actFollowActiveTool">
   <property name="checkable"><bool>true</bool></property>
   <property name="text"><string>Suivre l'outil actif</string></property>
  </action>
  <action name="actThemeSystem">
   <property name="checkable"><bool>true</bool></property>
   <property name="text"><string>Système</string></property>
  </action>
  <action name="actThemeLight">
   <property name="checkable"><bool>true</bool></property>
   <property name="text"><string>Clair</string></property>
  </action>
  <action name="actThemeDark">
   <property name="checkable"><bool>true</bool></property>
   <property name="text"><string>Sombre</string></property>
  </action>
 </widget>
 <resources/>
 <connections/>
</ui>
