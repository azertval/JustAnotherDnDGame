<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>CreditsScreen</class>
 <widget class="QWidget" name="CreditsScreen">
  <layout class="QVBoxLayout" name="verticalLayout">
   <!-- Marges posees en code (CreditsScreen::CreditsScreen, LOT-56) depuis l'echelle d'espacement
        des jetons, pas de nombre fige ici. -->
   <item>
    <widget class="hmi::TitleBanner" name="creditsTitle">
     <property name="text"><string>Crédits</string></property>
    </widget>
   </item>
   <item>
    <spacer name="titleSpacer">
     <property name="orientation"><enum>Qt::Vertical</enum></property>
     <property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property>
    </spacer>
   </item>
   <!-- Contenu dans un cadre pixel (LOT-68) : la maquette pose les trois sections sur une carte,
        pas a nu sur le fond. -->
   <item>
    <widget class="hmi::ParchmentPanel" name="creditsCard">
     <layout class="QVBoxLayout" name="cardLayout">
       <item>
        <widget class="QLabel" name="developmentLabel">
         <property name="creditsRole" stdset="0"><string>section</string></property>
         <property name="text"><string>Développement</string></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="developmentCredit">
         <property name="creditsRole" stdset="0"><string>entry</string></property>
         <!-- Nom propre : jamais traduit, cf. CreditsScreen::retranslateUi. -->
         <property name="text"><string>Valentin Eloy</string></property>
        </widget>
       </item>
       <item>
        <spacer name="sectionSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property>
        </spacer>
       </item>
       <item>
        <widget class="QLabel" name="audioLabel">
         <property name="creditsRole" stdset="0"><string>section</string></property>
         <property name="text"><string>Musique et bruitages</string></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="audioCredit">
         <property name="creditsRole" stdset="0"><string>entry</string></property>
         <!-- Noms propres et licence : jamais traduits. Detail complet dans
              Source/Elements/Audio/CREDITS.md (fichier par fichier). -->
         <property name="wordWrap"><bool>true</bool></property>
         <property name="text"><string>Kenney (www.kenney.nl) — Digital Audio, Impact Sounds, RPG Audio, Interface Sounds — licence CC0 1.0 Universal (domaine public)</string></property>
        </widget>
       </item>
       <item>
        <spacer name="graphicsSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property>
        </spacer>
       </item>
       <item>
        <widget class="QLabel" name="graphicsLabel">
         <property name="creditsRole" stdset="0"><string>section</string></property>
         <property name="text"><string>Graphismes</string></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="graphicsCredit">
         <property name="creditsRole" stdset="0"><string>entry</string></property>
         <!-- Noms propres et licence : jamais traduits. Detail complet dans
              Source/Elements/Assets/CREDITS.md (fichier par fichier). -->
         <property name="wordWrap"><bool>true</bool></property>
         <property name="text"><string>Kenney (www.kenney.nl) — Platformer Pack Remastered, Platformer Pack: Industrial — licence CC0 1.0 Universal (domaine public)</string></property>
        </widget>
       </item>
       <item>
        <spacer name="fontsSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property>
        </spacer>
       </item>
       <item>
        <widget class="QLabel" name="fontsLabel">
         <property name="creditsRole" stdset="0"><string>section</string></property>
         <property name="text"><string>Polices</string></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="fontsCredit">
         <property name="creditsRole" stdset="0"><string>entry</string></property>
         <!-- Noms propres et licence : jamais traduits. La SIL OFL EXIGE que sa notice accompagne
              les polices partout ou elles sont redistribuees : les fichiers de licence vivent dans
              Source/Elements/Assets/Fonts/. -->
         <property name="wordWrap"><bool>true</bool></property>
         <property name="text"><string>Inter, Pixelify Sans, Press Start 2P — SIL Open Font License 1.1</string></property>
        </widget>
       </item>
       <item>
        <spacer name="librariesSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property>
        </spacer>
       </item>
       <item>
        <widget class="QLabel" name="librariesLabel">
         <property name="creditsRole" stdset="0"><string>section</string></property>
         <property name="text"><string>Bibliothèques</string></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="librariesCredit">
         <property name="creditsRole" stdset="0"><string>entry</string></property>
         <!-- Mention EXIGEE par la LGPLv3 : l'usage de Qt et sa licence doivent etre indiques, et
              le lien reste dynamique pour que l'utilisateur puisse substituer sa propre version.
              Detail complet dans THIRD-PARTY-NOTICES.md. -->
         <property name="wordWrap"><bool>true</bool></property>
         <property name="text"><string>Qt 6 (www.qt.io) — licence LGPL v3, lien dynamique</string></property>
        </widget>
       </item>
       <item>
        <spacer name="licenseSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property>
        </spacer>
       </item>
       <item>
        <widget class="QLabel" name="licenseLabel">
         <property name="creditsRole" stdset="0"><string>section</string></property>
         <property name="text"><string>Licence</string></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="licenseCredit">
         <property name="creditsRole" stdset="0"><string>entry</string></property>
         <!-- La licence du JEU, distincte de celles ci-dessus : les ressources restent sous CC0 et
              SIL OFL, Qt sous LGPLv3. Le dire ici evite de laisser croire que tout est GPL. -->
         <property name="wordWrap"><bool>true</bool></property>
         <property name="text"><string>Just Another D&amp;D Game — GNU General Public License v3.0 ou ultérieure. Ressources et bibliothèques sous leurs licences propres, ci-dessus.</string></property>
        </widget>
