 <class>CreditsScreen</class>
 <widget class="QWidget" name="CreditsScreen">
  <property name="styleSheet">
   <string notr="true">#CreditsScreen {
    background-color: #d0c0a0;
    font-family: "Pixelify Sans", monospace;
    font-size: 20px;
    color: #302000;
}

#CreditsScreen QLabel#creditsTitle {
    color: #c0b080;
    font-family: "Press Start 2P", monospace;
    font-size: 46px;
    font-weight: bold;
}

#CreditsScreen QPushButton {
    color: #705020;
    background: transparent;
    border: none;
    border-radius: 0;
    text-align: left;
    padding: 8px 12px;
    font-size: 28px;
    font-weight: bold;
}

#CreditsScreen QPushButton:hover, #CreditsScreen QPushButton:focus {
    color: #c0a060;
}

#CreditsScreen QLabel[creditsRole="section"] {
    color: #c0a060;
    font-size: 20px;
    font-weight: bold;
}

#CreditsScreen QLabel[creditsRole="entry"] {
    color: #705020;
    font-size: 16px;
}</string>
