<?xml version='1.0' encoding='utf-8'?>
<ui version="4.0">
 <class>RpgTeamSheetScreen</class>
 <widget class="QWidget" name="RpgTeamSheetScreen">
  <property name="styleSheet">
   <string notr="true">#RpgTeamSheetScreen {
    background-color: #d0c0a0;
    font-family: "Pixelify Sans", monospace;
    font-size: 20px;
    color: #302000;
}

#RpgTeamSheetScreen QScrollArea, #RpgTeamSheetScreen QScrollArea &gt; QWidget &gt; QWidget {
    background: transparent;
    border: none;
}

#RpgTeamSheetScreen QLabel#rpgTitle {
    color: #c0b080;
    font-family: "Press Start 2P", monospace;
    font-size: 28px;
    font-weight: bold;
}

#RpgTeamSheetScreen QLabel[rpgRole="block"] {
    color: #c0a060;
    font-size: 20px;
    font-weight: bold;
}

#RpgTeamSheetScreen QLabel[rpgRole="field"] {
    color: #705020;
    font-size: 16px;
}

#RpgTeamSheetScreen QLabel[rpgRole="value"] {
    color: #302000;
    font-size: 20px;
}

#RpgTeamSheetScreen QLabel[rpgRole="bigValue"] {
    color: #302000;
    font-family: "Press Start 2P", monospace;
    font-size: 28px;
    font-weight: bold;
}

#RpgTeamSheetScreen QFrame[rpgRole="hairline"] {
    background-color: #c0a060;
    border: none;
}

#RpgTeamSheetScreen QLabel[rpgRole="signature"] {
    color: #705020;
    font-size: 20px;
    border-bottom: 1px dotted #907030;
}

#RpgTeamSheetScreen QLabel[rpgRole="prose"] {
    color: #705020;
    font-size: 20px;
}

#RpgTeamSheetScreen QFrame[rpgRole="cell"], #RpgTeamSheetScreen QFrame[rpgRole="chip"], #RpgTeamSheetScreen QFrame[rpgRole="action"], #RpgTeamSheetScreen QFrame[rpgRole="illustration"] {
    background: #f0e0d0;
    border: 2px solid #302000;
    border-radius: 0;
}

#RpgTeamSheetScreen QFrame[rpgRole="row"] {
    background: transparent;
    border: none;
    border-bottom: 2px solid #907030;
    border-radius: 0;
}

#RpgTeamSheetScreen hmi--MenuEntryButton {
    color: #705020;
    background: transparent;
    border: none;
    text-align: left;
    padding: 8px 12px;
    font-size: 20px;
    font-weight: bold;
}

#RpgTeamSheetScreen hmi--MenuEntryButton:hover, #RpgTeamSheetScreen hmi--MenuEntryButton:focus {
    color: #c0a060;
    background: transparent;
}</string>
  </property>
