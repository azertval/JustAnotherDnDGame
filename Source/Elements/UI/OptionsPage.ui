       <item row="1" column="1"><widget class="QCheckBox" name="fullscreenCheck"><property name="text"><string>Plein écran</string></property></widget></item>
       <!-- Les selecteurs de resolution et de limite d'images/s ont ete RETIRES au LOT-68
