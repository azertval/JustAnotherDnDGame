       <item row="1" column="0"><widget class="QLabel" name="logsLabel"><property name="text"><string>Journaux</string></property></widget></item>
       <item row="1" column="1"><widget class="QPushButton" name="saveLogsButton"><property name="text"><string>Enregistrer les journaux de session</string></property></widget></item>
