 <class>OptionsPage</class>
 <widget class="QWidget" name="OptionsPage">
  <layout class="QVBoxLayout" name="verticalLayout">
   <!-- Marges posees en code (OptionsPage::OptionsPage, LOT-56) depuis l'echelle d'espacement des
