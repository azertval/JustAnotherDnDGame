     <widget class="QWidget" name="generalTab">
      <attribute name="title"><string>Général</string></attribute>
      <layout class="QFormLayout" name="generalForm">
       <item row="0" column="0"><widget class="QLabel" name="languageLabel"><property name="text"><string>Langue</string></property></widget></item>
