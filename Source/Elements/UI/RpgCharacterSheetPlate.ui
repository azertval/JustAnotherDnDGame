  </property>
  <property name="styleSheet">
   <string notr="true">#RpgCharacterSheetPlate {
    background-color: #d0c0a0;
    font-family: &quot;Pixelify Sans&quot;, monospace;
    font-size: 20px;
    color: #302000;
}

#RpgCharacterSheetPlate QScrollArea, #RpgCharacterSheetPlate QScrollArea &gt; QWidget &gt; QWidget {
    background: transparent;
    border: none;
}

#RpgCharacterSheetPlate QLabel#rpgTitle {
    color: #c0b080;
    font-family: &quot;Press Start 2P&quot;, monospace;
    font-size: 28px;
    font-weight: bold;
}

#RpgCharacterSheetPlate QLabel[rpgRole=&quot;block&quot;] {
    color: #c0a060;
    font-size: 20px;
    font-weight: bold;
}

#RpgCharacterSheetPlate QLabel[rpgRole=&quot;field&quot;] {
    color: #705020;
    font-size: 16px;
}

#RpgCharacterSheetPlate QLabel[rpgRole=&quot;value&quot;] {
    color: #302000;
    font-size: 20px;
}

#RpgCharacterSheetPlate QLabel[rpgRole=&quot;bigValue&quot;] {
    color: #302000;
    font-family: &quot;Press Start 2P&quot;, monospace;
    font-size: 28px;
    font-weight: bold;
}

#RpgCharacterSheetPlate QFrame[rpgRole=&quot;hairline&quot;] {
    background-color: #c0a060;
    border: none;
}

#RpgCharacterSheetPlate QLabel[rpgRole=&quot;signature&quot;] {
    color: #705020;
    font-size: 20px;
    border-bottom: 1px dotted #907030;
}

#RpgCharacterSheetPlate QLabel[rpgRole=&quot;prose&quot;] {
    color: #705020;
    font-size: 20px;
}

#RpgCharacterSheetPlate QFrame[rpgRole=&quot;cell&quot;], #RpgCharacterSheetPlate QFrame[rpgRole=&quot;chip&quot;], #RpgCharacterSheetPlate QFrame[rpgRole=&quot;action&quot;], #RpgCharacterSheetPlate QFrame[rpgRole=&quot;illustration&quot;] {
    background: #f0e0d0;
    border: 2px solid #302000;
    border-radius: 0;
}

#RpgCharacterSheetPlate QFrame[rpgRole=&quot;row&quot;] {
    background: transparent;
    border: none;
    border-bottom: 2px solid #907030;
    border-radius: 0;
}

#RpgCharacterSheetPlate hmi--MenuEntryButton {
    color: #705020;
    background: transparent;
    border: none;
    text-align: left;
    padding: 8px 12px;
    font-size: 20px;
    font-weight: bold;
}

#RpgCharacterSheetPlate hmi--MenuEntryButton:hover, #RpgCharacterSheetPlate hmi--MenuEntryButton:focus {
    color: #c0a060;
    background: transparent;
}</string>
