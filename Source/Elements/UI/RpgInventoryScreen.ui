<ui version="4.0">
 <class>RpgInventoryScreen</class>
 <widget class="QWidget" name="RpgInventoryScreen">
  <property name="styleSheet">
   <string notr="true">#RpgInventoryScreen {
    background-color: #d0c0a0;
    font-family: "Pixelify Sans", monospace;
    font-size: 20px;
    color: #302000;
}

#RpgInventoryScreen QScrollArea, #RpgInventoryScreen QScrollArea &gt; QWidget &gt; QWidget {
    background: transparent;
    border: none;
}

#RpgInventoryScreen QLabel#rpgTitle {
    color: #c0b080;
    font-family: "Press Start 2P", monospace;
    font-size: 28px;
    font-weight: bold;
}

#RpgInventoryScreen QLabel[rpgRole="block"] {
    color: #c0a060;
    font-size: 20px;
    font-weight: bold;
}

#RpgInventoryScreen QLabel[rpgRole="field"] {
    color: #705020;
    font-size: 16px;
}

#RpgInventoryScreen QLabel[rpgRole="value"] {
    color: #302000;
    font-size: 20px;
}

#RpgInventoryScreen QLabel[rpgRole="bigValue"] {
    color: #302000;
    font-family: "Press Start 2P", monospace;
    font-size: 28px;
    font-weight: bold;
}

#RpgInventoryScreen QFrame[rpgRole="hairline"] {
    background-color: #c0a060;
    border: none;
}

#RpgInventoryScreen QLabel[rpgRole="signature"] {
    color: #705020;
    font-size: 20px;
    border-bottom: 1px dotted #907030;
}

#RpgInventoryScreen QLabel[rpgRole="prose"] {
    color: #705020;
    font-size: 20px;
}

#RpgInventoryScreen QFrame[rpgRole="cell"], #RpgInventoryScreen QFrame[rpgRole="chip"], #RpgInventoryScreen QFrame[rpgRole="action"], #RpgInventoryScreen QFrame[rpgRole="illustration"] {
    background: #f0e0d0;
    border: 2px solid #302000;
    border-radius: 0;
}

#RpgInventoryScreen QFrame[rpgRole="row"] {
    background: transparent;
    border: none;
    border-bottom: 2px solid #907030;
    border-radius: 0;
}

#RpgInventoryScreen hmi--MenuEntryButton {
    color: #705020;
    background: transparent;
    border: none;
    text-align: left;
    padding: 8px 12px;
    font-size: 20px;
    font-weight: bold;
}

#RpgInventoryScreen hmi--MenuEntryButton:hover, #RpgInventoryScreen hmi--MenuEntryButton:focus {
    color: #c0a060;
    background: transparent;
}</string>
