<ui version="4.0">
 <class>RpgMerchantScreen</class>
 <widget class="QWidget" name="RpgMerchantScreen">
  <property name="styleSheet">
   <string notr="true">#RpgMerchantScreen {
    background-color: #d0c0a0;
    font-family: "Pixelify Sans", monospace;
    font-size: 20px;
    color: #302000;
}

#RpgMerchantScreen QScrollArea, #RpgMerchantScreen QScrollArea &gt; QWidget &gt; QWidget {
    background: transparent;
    border: none;
}

#RpgMerchantScreen QLabel#rpgTitle {
    color: #c0b080;
    font-family: "Press Start 2P", monospace;
    font-size: 28px;
    font-weight: bold;
}

#RpgMerchantScreen QLabel[rpgRole="block"] {
    color: #c0a060;
    font-size: 20px;
    font-weight: bold;
}

#RpgMerchantScreen QLabel[rpgRole="field"] {
    color: #705020;
    font-size: 16px;
}

#RpgMerchantScreen QLabel[rpgRole="value"] {
    color: #302000;
    font-size: 20px;
}

#RpgMerchantScreen QLabel[rpgRole="bigValue"] {
    color: #302000;
    font-family: "Press Start 2P", monospace;
    font-size: 28px;
    font-weight: bold;
}

#RpgMerchantScreen QFrame[rpgRole="hairline"] {
    background-color: #c0a060;
    border: none;
}

#RpgMerchantScreen QLabel[rpgRole="signature"] {
    color: #705020;
    font-size: 20px;
    border-bottom: 1px dotted #907030;
}

#RpgMerchantScreen QLabel[rpgRole="prose"] {
    color: #705020;
    font-size: 20px;
}

#RpgMerchantScreen QFrame[rpgRole="cell"], #RpgMerchantScreen QFrame[rpgRole="chip"], #RpgMerchantScreen QFrame[rpgRole="action"], #RpgMerchantScreen QFrame[rpgRole="illustration"] {
    background: #f0e0d0;
    border: 2px solid #302000;
    border-radius: 0;
}

#RpgMerchantScreen QFrame[rpgRole="row"] {
    background: transparent;
    border: none;
    border-bottom: 2px solid #907030;
    border-radius: 0;
}

#RpgMerchantScreen hmi--MenuEntryButton {
    color: #705020;
    background: transparent;
    border: none;
    text-align: left;
    padding: 8px 12px;
    font-size: 20px;
    font-weight: bold;
}

#RpgMerchantScreen hmi--MenuEntryButton:hover, #RpgMerchantScreen hmi--MenuEntryButton:focus {
    color: #c0a060;
    background: transparent;
}</string>
