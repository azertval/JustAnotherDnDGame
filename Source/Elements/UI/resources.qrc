<!DOCTYPE RCC>
<RCC version="1.0">
  <qresource prefix="/">
    <!-- Feuilles de style (Elements/Themes) embarquées, une par PORTÉE (LOT-73, EX-IHM-082).
         Elles étaient un seul fichier posé sur l'application entière : un changement de facteur
         d'agrandissement, qui ne concerne que les écrans du jeu, repolissait alors les 862 widgets
         de l'application. Séparées, chacune s'applique là où elle porte — l'identité sur la pile
         d'écrans, le châssis sur l'application.
         Les alias conservent des chemins runtime stables, indépendants de l'emplacement source. -->
    <file alias="resources/theme-identity.qss">../Themes/theme-identity.qss</file>
    <file alias="resources/theme-editor.qss">../Themes/theme-editor.qss</file>

    <!-- Icones d'emplacement d'equipement (Elements/Assets/Icons/slot), une par emplacement de
         `core::EquipmentSlot`. Generees par `scripts/generate_slot_icons.py`, dont la table est
         la seule liste : cette enumeration la SUIT, elle ne la remplace pas.
         Embarquees et non lues sur le disque, pour la raison qui vaut deja aux feuilles de
         style : une icone manquante a l'installation donnerait un emplacement vide, qu'on
         prendrait pour << rien d'equipe >>.
         Leur trait est `currentColor` — le chargeur y substitue le role demande
         (EX-IHM-051). -->
    <file alias="resources/icons/slot/ammunition.svg">../Assets/Icons/slot/ammunition.svg</file>
    <file alias="resources/icons/slot/belt.svg">../Assets/Icons/slot/belt.svg</file>
    <file alias="resources/icons/slot/bracers.svg">../Assets/Icons/slot/bracers.svg</file>
    <file alias="resources/icons/slot/cloak.svg">../Assets/Icons/slot/cloak.svg</file>
    <file alias="resources/icons/slot/feet.svg">../Assets/Icons/slot/feet.svg</file>
    <file alias="resources/icons/slot/hands.svg">../Assets/Icons/slot/hands.svg</file>
    <file alias="resources/icons/slot/head.svg">../Assets/Icons/slot/head.svg</file>
    <file alias="resources/icons/slot/main-hand.svg">../Assets/Icons/slot/main-hand.svg</file>
    <file alias="resources/icons/slot/neck.svg">../Assets/Icons/slot/neck.svg</file>
    <file alias="resources/icons/slot/off-hand.svg">../Assets/Icons/slot/off-hand.svg</file>
    <file alias="resources/icons/slot/pouch.svg">../Assets/Icons/slot/pouch.svg</file>
    <file alias="resources/icons/slot/ranged.svg">../Assets/Icons/slot/ranged.svg</file>
    <file alias="resources/icons/slot/ring-left.svg">../Assets/Icons/slot/ring-left.svg</file>
    <file alias="resources/icons/slot/ring-right.svg">../Assets/Icons/slot/ring-right.svg</file>
    <file alias="resources/icons/slot/torso.svg">../Assets/Icons/slot/torso.svg</file>
    <file alias="resources/icons/slot/trinket.svg">../Assets/Icons/slot/trinket.svg</file>

  </qresource>
</RCC>
