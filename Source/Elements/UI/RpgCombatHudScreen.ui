 <class>RpgCombatHudScreen</class>
 <widget class="QWidget" name="RpgCombatHudScreen">
  <property name="styleSheet">
   <string notr="true">#RpgCombatHudScreen {
    background-color: #d0c0a0;
    font-family: "Pixelify Sans", monospace;
    font-size: 20px;
    color: #302000;
}

#RpgCombatHudScreen QScrollArea, #RpgCombatHudScreen QScrollArea &gt; QWidget &gt; QWidget {
    background: transparent;
    border: none;
}

#RpgCombatHudScreen QLabel#rpgTitle {
    color: #c0b080;
    font-family: "Press Start 2P", monospace;
    font-size: 28px;
    font-weight: bold;
}

#RpgCombatHudScreen QLabel[rpgRole="block"] {
    color: #c0a060;
    font-size: 20px;
    font-weight: bold;
}

#RpgCombatHudScreen QLabel[rpgRole="field"] {
    color: #705020;
    font-size: 16px;
}

#RpgCombatHudScreen QLabel[rpgRole="value"] {
    color: #302000;
    font-size: 20px;
}

#RpgCombatHudScreen QLabel[rpgRole="bigValue"] {
    color: #302000;
    font-family: "Press Start 2P", monospace;
    font-size: 28px;
    font-weight: bold;
}

#RpgCombatHudScreen QFrame[rpgRole="hairline"] {
    background-color: #c0a060;
    border: none;
}

#RpgCombatHudScreen QLabel[rpgRole="signature"] {
    color: #705020;
    font-size: 20px;
    border-bottom: 1px dotted #907030;
}

#RpgCombatHudScreen QLabel[rpgRole="prose"] {
    color: #705020;
    font-size: 20px;
}

#RpgCombatHudScreen QFrame[rpgRole="cell"], #RpgCombatHudScreen QFrame[rpgRole="chip"], #RpgCombatHudScreen QFrame[rpgRole="action"], #RpgCombatHudScreen QFrame[rpgRole="illustration"] {
    background: #f0e0d0;
    border: 2px solid #302000;
    border-radius: 0;
}

#RpgCombatHudScreen QFrame[rpgRole="row"] {
    background: transparent;
    border: none;
    border-bottom: 2px solid #907030;
    border-radius: 0;
}

#RpgCombatHudScreen hmi--MenuEntryButton {
    color: #705020;
    background: transparent;
    border: none;
    text-align: left;
    padding: 8px 12px;
    font-size: 20px;
    font-weight: bold;
}

#RpgCombatHudScreen hmi--MenuEntryButton:hover, #RpgCombatHudScreen hmi--MenuEntryButton:focus {
    color: #c0a060;
    background: transparent;
}</string>
