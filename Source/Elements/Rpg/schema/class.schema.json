{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://justanotherdndgame.local/rpg/class.schema.json",
  "title": "Classe",
  "description": "Une classe jouable. Sa TABLE DE PROGRESSION est une donnee a part entiere (LOT-84, 31 tables detectees dans le corpus) : une ligne par niveau, jamais une regle en C++. Les ressources declarent ELLES-MEMES leur cadence de recuperation (EX-DND-031), sans quoi chacun des quinze lots de classes modifierait le code du repos, et la quinzieme modification casserait la premiere.",
  "allOf": [
    {
      "$ref": "https://justanotherdndgame.local/rpg/common.schema.json#/$defs/entree"
    }
  ],
  "type": "object",
  "properties": {
    "id": true,
    "name": true,
    "source": true,
    "status": true,
    "asset": true,
    "mecanismesRequis": true,
    "narratif": true,
    "hitDie": {
      "type": "integer",
      "enum": [
        6,
        8,
        10,
        12
      ]
    },
    "primaryAbility": {
      "type": "array",
      "items": {
        "$ref": "https://justanotherdndgame.local/rpg/common.schema.json#/$defs/ability"
      },
      "uniqueItems": true
    },
    "savingThrowProficiencies": {
      "type": "array",
      "items": {
        "$ref": "https://justanotherdndgame.local/rpg/common.schema.json#/$defs/ability"
      },
      "uniqueItems": true,
      "minItems": 2,
      "maxItems": 2
    },
    "subclassLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "progression": {
      "type": "array",
      "description": "Une entree par niveau atteint ; les niveaux qui n'apportent rien peuvent etre omis.",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "proficiencyBonus": {
            "type": "integer",
            "minimum": 2,
            "maximum": 6
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "https://justanotherdndgame.local/rpg/common.schema.json#/$defs/id"
            },
            "uniqueItems": true
          },
          "spellSlots": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "maxItems": 9
          },
          "resources": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "level",
          "proficiencyBonus"
        ],
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://justanotherdndgame.local/rpg/common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "recharge": {
            "type": "string",
            "enum": [
              "short-rest",
              "long-rest",
              "at-will",
              "dawn"
            ],
            "description": "Cadence de recuperation declaree PAR LA RESSOURCE (EX-DND-031) : le mecanisme de repos ne connait aucune classe en particulier."
          }
        },
        "required": [
          "id",
          "name",
          "recharge"
        ],
        "additionalProperties": false
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "name",
    "source",
    "hitDie",
    "primaryAbility",
    "savingThrowProficiencies"
  ],
  "additionalProperties": false
}
